# ${API_UPSTREAM} est remplacé au démarrage du conteneur (envsubst de l'image nginx).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 20m;

    # DNS interne Docker : résolution à la volée, nginx démarre même si la gateway n'est pas encore prête
    resolver 127.0.0.11 valid=10s ipv6=off;

    # API → gateway (réseau Docker interne, la gateway n'a pas besoin d'être exposée)
    location /api/ {
        set $upstream ${API_UPSTREAM};
        proxy_pass $upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Fichiers générés par Vite (noms hashés) : cache long
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Application React (routing côté client)
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
}
